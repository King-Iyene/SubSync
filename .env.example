# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (service role key is server-only, never expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key, base64 (openssl rand -base64 32). Encrypts GHL tokens at rest.
TOKEN_ENCRYPTION_KEY=

# GHL marketplace app (from the developer portal)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_SSO_KEY=
GHL_REDIRECT_URI=http://localhost:3000/api/oauth/callback
