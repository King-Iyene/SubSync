# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase. The Vercel integration sets these in production. The secret key is
# server-only and bypasses RLS: never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Used for `supabase db push --db-url` from your machine only.
SUPABASE_DB_PASSWORD=

# 32-byte key, base64 (openssl rand -base64 32). Encrypts GHL tokens at rest.
TOKEN_ENCRYPTION_KEY=

# GHL marketplace app (from the developer portal)
# Marketplace app id (from the app's address in the developer portal)
GHL_APP_ID=
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_SSO_KEY=
GHL_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# Cron routes (/api/cron/*) require this as a Bearer token; Vercel sends it automatically.
CRON_SECRET=

# Pooled Postgres URL. Set by the Vercel Supabase integration; locally it is built from SUPABASE_DB_PASSWORD.
POSTGRES_URL=

# Optional switches
# DEMO_MODE=true      fake agency for screenshots and demos; never enable in production
# ENFORCE_PLANS=true  turn on free-plan limits (5 client accounts, core views only)

# Live switches (dry-run mode, src/lib/live-flags.ts). Off unless the value is exactly the word true. With one off, the action is only recorded as a WOULD line
# (ids and field names only) in the audit log and nothing is sent. Leave all four off until the morning tests in docs/features/E0.md pass.
# SEND_EMAIL_LIVE=true
# SEND_SLACK_LIVE=true
# WRITE_GHL_LIVE=true        notes, internal comments and custom fields written into a customer CRM
# FATHOM_WEBHOOK_LIVE=true   creating and deleting meeting-tool delivery subscriptions
